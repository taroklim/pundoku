{
  "name": "@pundoku/engine",
  "version": "0.1.0",
  "description": "Pundoku engine — генератор и решатель судоку с логом техник. Без DOM-зависимостей, MIT.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
