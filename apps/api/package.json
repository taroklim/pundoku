{
  "name": "@pundoku/api",
  "version": "0.1.0",
  "private": true,
  "description": "Pundoku api — минимальный Node/TS бэкенд: прокси Sudoku.com (Today) с кэшем/фолбэком + анонимный аккаунт устройства и снапшот прогресса.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@pundoku/engine": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
