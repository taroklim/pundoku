{
  "name": "@pundoku/api",
  "version": "0.1.0",
  "private": true,
  "description": "Pundoku api — минимальный Node/TS бэкенд: прокси Sudoku.com (Today) + бэкап прогресса. PD-0: только /health и раннер миграций.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
