{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "sourceMap": true,
    "noEmit": true,
    // typecheck/редактор видят движок по исходникам, а не по dist: `pnpm typecheck` работает из
    // чистого клона без предварительного `pnpm build`. Сборка (tsconfig.build.json) paths сбрасывает.
    "paths": { "@pundoku/engine": ["../../packages/engine/src/index.ts"] }
  },
  "include": ["src/**/*.ts"]
}
