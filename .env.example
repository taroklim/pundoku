# Скопируй в .env (не коммитится). Используется docker-compose.yml / docker-compose.dev.yml и apps/api.

# --- Postgres (docker compose; dev: docker-compose.dev.yml) ---
# В ПРОДЕ (docker-compose.yml) пароль обязателен, без дефолта: `openssl rand -hex 24` (hex — чтобы не ломать URL
# подключения; символы вроде / + = пришлось бы экранировать в DATABASE_URL).
POSTGRES_USER=pundoku
POSTGRES_PASSWORD=pundoku
POSTGRES_DB=pundoku

# --- api ---
# Локальный dev (`pnpm dev:api` против `docker compose -f docker-compose.dev.yml up -d`):
DATABASE_URL=postgres://pundoku:pundoku@localhost:5432/pundoku
# Порт api: целое 1–65535 (иное — ошибка конфигурации при старте).
PORT=3000
# Источник ежедневной сетки. Только через прокси api, никогда из браузера (CORS/ToS).
SUDOKU_COM_BASE_URL=https://sudoku.com/api/v2
# SUDOKU_COM_TIMEOUT_MS=5000
# Сложность сгенерированной сетки дня, когда Sudoku.com недоступен: easy|medium|hard|expert|master.
# По умолчанию medium (30 подсказок/singles) ≈ Sudoku.com daily «hard».
# DAILY_FALLBACK_DIFFICULTY=medium
# Разрешённые origin'ы для CORS (через запятую). Dev-сервер web — vite :5173.
WEB_ORIGIN=http://localhost:5173
# LOG_LEVEL=info   # trace|debug|info|warn|error|fatal|silent
# TRUST_PROXY=1   # за reverse proxy, чтобы rate-limit по IP видел реальный адрес
# Секрет HMAC ключей восстановления (PD-27). Вне development/test ОБЯЗАТЕЛЕН, ≥32 байт: `openssl rand -base64 48`.
# Сменишь/потеряешь — все выданные ключи перестанут работать (в БД лежит HMAC, не сам ключ). В dev без него —
# встроенный dev-секрет с предупреждением в логе.
# RECOVERY_KEY_HMAC_SECRET=

# --- web (vite, build-time) ---
# Base URL api для клиента (`apps/web`). Пусто — тот же origin: в dev/preview запросы `/api/*` идут
# через прокси Vite на localhost:3000. В проде web и api на одном origin (nginx проксирует /api) — оставь пусто;
# если когда-нибудь api уедет на другой хост — публичный адрес api (https://…, без «/»), а WEB_ORIGIN api
# должен содержать origin web.
# VITE_API_BASE_URL=

# --- ПРОД-стек (docker-compose.yml; на ноуте .env пишет deploy.yml из GitHub Secrets/Variables, см. DEPLOY.md) ---
# Обязательны в проде — без них `docker compose up` падает с понятным сообщением:
#   POSTGRES_PASSWORD          (см. выше)
#   RECOVERY_KEY_HMAC_SECRET   (см. выше; в проде обязателен, >=32 байт)
#   PUBLIC_ORIGIN              публичный https-адрес PWA без завершающего «/»; уходит в WEB_ORIGIN api
# PUBLIC_ORIGIN=https://pundoku.example.com
# В проде api получает NODE_ENV=production и TRUST_PROXY=1 из docker-compose.yml, DATABASE_URL и PORT
# собираются там же — в .env для прода их класть не нужно.
