# Скопируй в .env (не коммитится). Используется docker-compose.yml и apps/api.

# --- Postgres (docker compose) ---
POSTGRES_USER=pundoku
POSTGRES_PASSWORD=pundoku
POSTGRES_DB=pundoku

# --- api ---
# Локальный dev (`pnpm dev:api` против `docker compose up -d postgres`):
DATABASE_URL=postgres://pundoku:pundoku@localhost:5432/pundoku
PORT=3000
# Источник ежедневной сетки. Только через прокси api, никогда из браузера (CORS/ToS).
SUDOKU_COM_BASE_URL=https://sudoku.com/api/v2
