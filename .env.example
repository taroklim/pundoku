# Скопируй в .env (не коммитится). Используется docker-compose.yml и apps/api.

# --- Postgres (docker compose) ---
POSTGRES_USER=pundoku
POSTGRES_PASSWORD=pundoku
POSTGRES_DB=pundoku

# --- api ---
# Локальный dev (`pnpm dev:api` против `docker compose up -d postgres`):
DATABASE_URL=postgres://pundoku:pundoku@localhost:5432/pundoku
PORT=3000
# Источник ежедневной сетки. Только через прокси api, никогда из браузера (CORS/ToS).
SUDOKU_COM_BASE_URL=https://sudoku.com/api/v2
# SUDOKU_COM_TIMEOUT_MS=5000
# Сложность сгенерированной сетки дня, когда Sudoku.com недоступен (у Sudoku.com daily — hard).
# DAILY_FALLBACK_DIFFICULTY=hard
# Разрешённые origin'ы для CORS (через запятую). Dev-сервер web — vite :5173.
WEB_ORIGIN=http://localhost:5173
# LOG_LEVEL=info
# TRUST_PROXY=1   # за reverse proxy, чтобы rate-limit по IP видел реальный адрес
